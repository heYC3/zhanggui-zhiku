# 复制本文件为 .env 后再填写密钥。不要把填好的 .env 发给别人。

# ===================== 日志配置 =====================
LOG_CONSOLE_ENABLE=True
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_ENABLE=True
LOG_FILE_LEVEL=INFO
LOG_FILE_RETENTION=7 days

# ===================== MinerU：PDF 转 Markdown =====================
# 申请地址：https://mineru.net
MINERU_API_TOKEN=your token
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_MODEL_SOURCE=modelscope
MODELSCOPE_OFFLINE=0
# 填本机缓存目录（取消注释后写成自己的路径）
# MODELSCOPE_CACHE=
# HF_HOME=
MD_ROOT_DIR=./temp-files/

# ===================== 大模型（OpenAI GPT） =====================
# 文本模型用 gpt-6.1-sol（实测在型号提取任务上比 gpt-6-luna 稳）
# 看图模型用 gpt-4o-mini。gpt-6 系列只支持默认温度 1
LLM_DEFAULT_MODEL=gpt-6.1-sol
VL_MODEL=gpt-4o-mini
OPENAI_API_KEY=your key
OPENAI_BASE_URL=https://api.openai.com/v1
# gpt-6 系列只支持温度 1；换回 qwen/gpt-4o-mini 时可改回 0.1
LLM_DEFAULT_TEMPERATURE=1

# ===================== 手册图片用的 MinIO =====================
# 对应 deploy/docker-compose.yml 里的 minio 服务
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=knowledge-base-files
MINIO_IMG_DIR=upload-images
MINIO_SECURE=False

# ===================== 向量模型 BGE-M3 =====================
# 留空时按模型名自动下载。已经下过就把路径填成本地目录。
BGE_M3_PATH=
BGE_M3=BAAI/bge-m3
# 没有显卡就用 cpu；有 NVIDIA 显卡可改成 cuda:0，并把 BGE_FP16 改成 1
BGE_DEVICE=cpu
BGE_FP16=0

# ===================== Milvus =====================
MILVUS_URL=http://127.0.0.1:19530
CHUNKS_COLLECTION=kb_chunks
ENTITY_NAME_COLLECTION=kb_graph_entity_names
ITEM_NAME_COLLECTION=kb_item_names
EMBEDDING_DIM=1024
MILVUS_METRIC_TYPE=COSINE
MILVUS_MIN_COSINE_SCORE=0.75

# ===================== MongoDB：聊天记录 =====================
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB_NAME=kb

# ===================== 联网搜索 MCP =====================
# 百炼 WebSearch。DASHSCOPE_API_KEY 留空时，这一路失败会退回本地手册。
WEB_SEARCH_ENABLE=true
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp
DASHSCOPE_API_KEY=

# ===================== 重排序 =====================
TEXT_RERANK_MODEL=qwen3-rerank
TEXT_RERANK_INSTRUCT=针对给定的查询，检索能够解答该查询的相关段落

# ===================== Listing 工作台 =====================
# 账号由服务端登记，格式：用户:密码:editor或viewer:机构
# 页面默认账号是「小明」，密码 demo-pass。仅本地演示，公开后请改掉。
LISTING_ACCOUNTS=小明:demo-pass:editor:org-demo
# 故障注入只在测试模式打开
# LISTING_TEST_MODE=0
# 证据：目录里有的商品走离线资料。设为 milvus 时目录外的手册走向量库
# EVIDENCE_BACKEND=
# 默认不用 BGE。改成 1 才会加载本仓库里的 BGE-M3，失败就退回离线字块。
LISTING_USE_BGE=0
# 草稿来源：offline 用证据原句，不调用模型；llm 才调用模型。
# llm 默认先走百炼，走不通再走 OpenAI。两家都走不通，就用知识库原句。点确认才写入。
# 同一条草稿实测：qwen-plus 约 1.6 秒，qwen3.8-flash 约 9.7 秒，所以百炼用 qwen-plus。
# OpenAI 后备用 gpt-6.1-terra。问答仍用 LLM_DEFAULT_MODEL。
LISTING_DRAFT_MODE=offline
LISTING_LLM_PROVIDER=bailian
# 百炼对话模型。qwen3-rerank 只做重排序，不写草稿。
LISTING_BAILIAN_MODEL=qwen-plus
# Listing 失败后改用的 OpenAI 模型。问答仍用上面的 LLM_DEFAULT_MODEL。
LISTING_OPENAI_MODEL=gpt-6.1-terra
LISTING_BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LISTING_BAILIAN_TEMPERATURE=0.1
# 真实模型草稿的超时，单位是秒。
LISTING_LLM_TIMEOUT_S=30
# 两项都填了才计算模型费用。缺单价或缺少 token 时，费用留空，不会写成 0。
# LISTING_LLM_USD_PER_MILLION_PROMPT=
# LISTING_LLM_USD_PER_MILLION_COMPLETION=
# 下面三项都填了，任务 trace 才会发给 Langfuse。不填只写本地 jsonl。
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# 留空则写到 knowledge_base/listing_data/runtime
LISTING_RUNTIME_DIR=
