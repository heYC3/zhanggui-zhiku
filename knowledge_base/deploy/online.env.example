# 实际文件放服务器 /opt/zhanggui/secrets.env，权限 600；不要放进仓库。
# 无自有域名可评估 PUBLIC_IP.sslip.io（依赖公共 DNS 和证书签发）。
PUBLIC_DOMAIN=your-domain.example
SHOPIFY_STORE_DOMAIN=zhanggui-test.myshopify.com
SHOPIFY_ADMIN_TOKEN=replace-with-private-token
LISTING_ACCOUNTS=owner:replace-with-at-least-20-random-characters:editor:org-owner
