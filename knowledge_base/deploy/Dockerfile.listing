FROM python:3.11-slim

WORKDIR /app

COPY requirements-listing.txt .
RUN pip install --no-cache-dir -r requirements-listing.txt

COPY app/__init__.py app/__init__.py
COPY app/listing_agent app/listing_agent
COPY listing_data listing_data

ENV PYTHONPATH=/app
ENV LISTING_RUNTIME_DIR=/app/listing_data/runtime

EXPOSE 8002

CMD ["python", "-m", "app.listing_agent"]
